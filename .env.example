# Codebase Oracle configuration
# Copy this file to ".env" and edit as needed.
# Environment variables override these values at runtime.

# Repository root to analyze (defaults to current working directory).
REPO_ROOT=C:\codebase-oracle

# Port the API server listens on.
PORT=3001

# Directory for all app data: repo registry, per-repo index data
# (graph.db, hash-cache, memory, audit logs) and ephemeral stores.
# Defaults to ./store under the working directory — set a full path
# for deployments where the working directory may vary (e.g. EC2).
# Example: STORE_DIR=D:\codebase-oracle-data  or  /var/lib/codebase-oracle
STORE_DIR=C:\codebase-oracle\store

# ── LLM Provider Selection ───────────────────────────────────────────
# Which provider to use for Q&A: "ollama", "omniroute", or "bedrock".
LLM_PROVIDER=ollama

# ── Ollama (used when LLM_PROVIDER=ollama) ──────────────────────────
# Ollama server endpoint.
OLLAMA_URL=http://localhost:11434
# Ollama model name. Run `ollama list` to see installed models, or
# `ollama pull <model>` to fetch one (e.g. qwen2.5-coder:7b, llama3.1:8b).
OLLAMA_MODEL=llama3.2

# ── Omniroute (used when LLM_PROVIDER=omniroute) ────────────────────
# Omniroute server endpoint (OpenAI-compatible /v1/chat/completions).
OMNIROUTE_URL=http://localhost:20128
# Model name from the Omniroute catalog. Can be a specific model
# (e.g. gpt-4o-mini, claude-3-5-sonnet) or an auto-routing variant that lets
# Omniroute pick the best available model from your connected providers:
#   auto            Balanced default (LKGP — sticks to last good provider)
#   auto/coding     Quality-first, optimized for code generation
#   auto/fast       Lowest latency first
#   auto/cheap      Cheapest per token first
#   auto/offline    Most quota / rate-limit headroom first
#   auto/smart      Quality-first + 10% exploration for better model discovery
OMNIROUTE_MODEL=auto
# Omniroute API key (Bearer token). Required when the Omniroute server is
# started with REQUIRE_API_KEY=true (common for remote/hosted setups);
# optional for local unauthenticated instances (REQUIRE_API_KEY=false).
OMNIROUTE_API_KEY=
# Example: OMNIROUTE_API_KEY=oma_live_your-key-here

# ── AWS Bedrock (used when LLM_PROVIDER=bedrock) ─────────────────────
# AWS region where your Bedrock models are deployed (e.g. us-east-1).
BEDROCK_REGION=us-east-1
# Bedrock model identifier. Examples:
#   anthropic.claude-3-5-sonnet-20241022-v2:0
#   anthropic.claude-3-5-haiku-20241022-v1:0
#   amazon.nova-pro-v1:0
#   meta.llama3-1-70b-instruct-v1:0
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# Authentication method — one of:
#   iam-long-term      Access key + secret access key + region
#   iam-short-term     Access key + secret access key + region + session token
#   api-key            Bedrock API key + region (endpoint derived from region)
#   api-key-endpoint   Bedrock API key + region + explicit API endpoint
BEDROCK_AUTH_METHOD=iam-long-term
# ── IAM credentials (iam-long-term / iam-short-term) ──
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
# Session token — only for iam-short-term (temporary/sts credentials).
BEDROCK_SESSION_TOKEN=
# ── API key credentials (api-key / api-key-endpoint) ──
BEDROCK_API_KEY=
# Explicit endpoint base URL — only for api-key-endpoint.
# If omitted, defaults to https://bedrock-runtime.<region>.amazonaws.com
# Example: BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
BEDROCK_ENDPOINT=

# ── Q&A System Prompt (applies to both providers) ───────────────────
# Optional: override the Q&A system prompt. Use the literal token {context}
# (case-sensitive) anywhere in the prompt to control where the knowledge-graph
# context is injected. If {context} is absent, the context is appended at the
# end. Leave commented out to use the built-in default prompt.
# OLLAMA_SYSTEM_PROMPT=You are a senior code reviewer. Use the graph context
# below to answer precisely, citing file paths. Context: {context}

# ── Agent Engine (Phase 2 agentic Q&A) ──────────────────────────────
# Log level for the structured logger: debug, info, warn, error, silent.
LOG_LEVEL=info
# Maximum iterations for the agentic tool-using loop before forcing a stop.
# Each iteration is one round of: model response → tool calls → tool results.
# Higher values allow more complex reasoning but take longer.
AGENT_MAX_ITERATIONS=15

# ── Agent Robustness (Phase 3) ──────────────────────────────────────
# Permission mode controls how the agent handles write/destructive tools:
#   discuss       — no tools allowed (pure conversation)
#   plan          — read-only tools only (no writes)
#   interactive   — ask user before write/destructive ops (default)
#   auto-approve  — auto-approve all tools (no user prompts)
#   bypass        — bypass all checks (testing/CLI only)
AGENT_PERMISSION_MODE=interactive
# Token budget for context compaction. When the conversation history
# approaches 80% of this budget, older messages are summarized to save space.
# Prevents context-limit crashes on long sessions.
AGENT_TOKEN_BUDGET=120000
